{
  "name": "palimpsity-mvp",
  "version": "0.1.0",
  "description": "A city builder where your solutions reshape the rules — playable MVP",
  "type": "module",
  "scripts": {
    "dev": "python -m http.server 5173",
    "test": "node --test test/sim-harness.mjs test/gameplay-regressions.mjs test/ui-contracts.mjs test/english-language.mjs test/localization.mjs test/embedded-assets.mjs",
    "test:gameplay": "node test/gameplay-regressions.mjs",
    "test:ui": "node test/ui-contracts.mjs",
    "test:language": "node test/english-language.mjs",
    "test:localization": "node test/localization.mjs",
    "test:assets": "node test/embedded-assets.mjs",
    "test:victory": "node test/victory-check.mjs",
    "test:artifact": "node test/artifact-check.mjs",
    "test:browser": "node test/game-browser-check.mjs",
    "test:diorama": "node test/diorama-state-check.mjs",
    "test:diorama-browser": "node test/diorama-browser-check.mjs",
    "test:complete": "node test/complete-state-check.mjs",
    "test:complete-browser": "node test/complete-browser-check.mjs",
    "build": "node build.mjs",
    "build:maquette-diorama": "node build-maquette-diorama.mjs",
    "build:maquette-complete": "node build-maquette-complete.mjs",
    "assets:diorama": "node build-diorama-assets.mjs"
  },
  "license": "CC0-1.0",
  "dependencies": {
    "esbuild": "^0.28.0",
    "three": "^0.160.0"
  }
